function render(){const q=deck[idx];selected=null;answered=false;$("category").textContent=q.cat;$("qNumber").textContent=`第 ${idx+1} 題 / 共 ${deck.length} 題`;$("caseText").textContent=q.case;$("questionText").textContent=q.q;$("options").innerHTML="";q.opts.forEach((opt,i)=>{const b=document.createElement("button");b.className="option";b.textContent=String.fromCharCode(65+i)+". "+opt;b.onclick=()=>{if(answered)return;selected=i;document.querySelectorAll(".option").forEach(x=>x.classList.remove("selected"));b.classList.add("selected")};$("options").appendChild(b)});$("feedback").className="feedback hidden";$("feedback").textContent="";$("checkBtn").classList.remove("hidden");$("nextBtn").classList.add("hidden");$("progressText").textContent=`${idx} / ${deck.length}`;$("bar").style.width=(idx/deck.length*100)+"%"}
function checkAnswer(){if(selected===null){$("feedback").className="feedback";$("feedback").textContent="請先選擇一個答案，再確認作答。";return}if(answered)return;answered=true;const q=deck[idx],ok=selected===q.a;if(ok)score++;results.push({q,selected,ok});$("score").textContent=Math.round(score/(idx+1)*100);document.querySelectorAll(".option").forEach((b,i)=>{b.disabled=true;if(i===q.a)b.classList.add("correct");if(i===selected&&!ok)b.classList.add("wrong")});$("feedback").className="feedback "+(ok?"good":"bad");$("feedback").innerHTML=`<strong>${ok?"答對了！":"再釐清一下觀念。"}</strong><div>${q.why}</div><p class="muted"><b>核心觀念：</b>${q.concept}</p>`;$("checkBtn").classList.add("hidden");$("nextBtn").classList.remove("hidden");$("progressText").textContent=`${idx+1} / ${deck.length}`;$("bar").style.width=((idx+1)/deck.length*100)+"%";$("nextBtn").textContent=idx===deck.length-1?"查看結果 →":"下一題 →"}
